.tutorial-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    /* El background-color se controla por script ahora */
    transition-duration: 0.3s;
    transition-property: background-color;
    display: flex;
    justify-content: center;
    align-items: flex-start;
}

.tutorial-panel {
    width: 550px;
    background-image: url("project://database/Assets/_Custom/UI/Sprites/Backgrounds/Fondo2.png?fileID=2800000&guid=72b6550b8e6bcd44b8e6e066f339e28e&type=3#Fondo2");
    background-color: transparent;
    border-width: 0px;
    margin-top: 50px;
    margin-left: 20px;
    padding: 90px 70px 80px 70px;
}

.tutorial-title {
    font-size: 45px;
    -unity-font-style: bold;
    color: rgb(60, 40, 20);
    -unity-text-align: middle-center;
    margin-bottom: 25px;
    -unity-text-outline-width: 0px;
}

.tutorial-steps-container {
    margin-bottom: 30px;
}

.tutorial-step {
    font-size: 22px;
    color: rgb(70, 50, 30);
    margin-bottom: 12px;
    white-space: normal;
}

.tutorial-step-active {
    color: rgb(40, 20, 0);
    -unity-font-style: bold;
}

.tutorial-step-done {
    color: rgb(39, 174, 96);
    -unity-font-style: italic;
    opacity: 0.9;
}

.tutorial-message {
    font-size: 24px;
    color: rgb(50, 30, 10);
    -unity-font-style: bold;
    white-space: normal;
    background-color: rgba(255, 255, 255, 0.65);
    padding: 15px;
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(80, 60, 40, 0.3);
}

.tutorial-glow {
    border-width: 5px;
    border-color: rgb(46, 204, 113);
    border-radius: 10px;
    scale: 1.05;
    transition-duration: 0.2s;
    transition-property: scale, border-color;
}

/* Alternate glow for things that should draw attention urgently */
.tutorial-glow-urgent {
    border-width: 6px;
    border-color: rgb(241, 196, 15);
    border-radius: 10px;
    scale: 1.1;
    transition-duration: 0.2s;
    transition-property: scale, border-color;
}
