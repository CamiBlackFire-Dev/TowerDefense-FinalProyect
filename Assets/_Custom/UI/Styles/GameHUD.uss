.wave-text {
    font-size: 40px;
    color: white;
    -unity-font-style: bold;
    text-shadow: 2px 2px 0 rgba(0,0,0,0.5);
}

.start-wave-btn {
    position: absolute;
    bottom: 170px;
    right: 20px;
    background-color: #27ae60;
    background-image: none;
    border-color: #2ecc71;
    border-width: 4px;
    padding: 15px 30px;
    font-size: 28px;
    border-radius: 15px;
    color: white;
    -unity-font-style: bold;
}

.start-wave-btn:hover {
    background-color: #2ecc71;
    scale: 1.05;
}

.start-wave-btn:active {
    scale: 0.95;
    background-color: #1e8449;
}

.big-announcer-container {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    transition-duration: 0.5s;
    transition-property: opacity, scale;
    opacity: 0; 
    scale: 0.8;
}

.big-announcer-text {
    font-size: 150px;
    color: #F1C40F;
    -unity-font-style: bold;
    text-shadow: 5px 5px 0 rgba(0,0,0,0.8);
    -unity-text-align: middle-center;
}

.fade-in {
    opacity: 1;
    scale: 1;
}
