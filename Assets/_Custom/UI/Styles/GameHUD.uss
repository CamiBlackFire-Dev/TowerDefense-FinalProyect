.hud-container {
    flex-grow: 1;
    justify-content: space-between;
    padding: 20px;
}
.top-bar {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    width: 100%;
}
.top-left-container {
    position: absolute;
    left: 0;
    top: 0;
    flex-direction: row;
    align-items: center;
}
.currency-container {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 10px 30px;
    border-radius: 15px;
    border-width: 4px;
    border-color: var(--color-accent);
}
.speed-wrapper {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 10px 15px;
    border-radius: 15px;
    border-width: 4px;
    border-color: var(--color-accent);
    margin-left: 10px;
}
.speed-label {
    font-size: 16px;
    color: rgb(240, 240, 240);
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: black;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.8);
    margin-bottom: 5px;
}
.speed-controls-container {
    flex-direction: row;
    align-items: center;
}
.speed-btn {
    width: 60px;
    height: 40px;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.5);
    background-color: rgba(50, 50, 50, 0.5);
    background-image: none;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(100, 100, 100, 0.5);
    margin: 0 4px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    transition-duration: 0.1s;
    transition-property: scale, background-color, color;
}
.speed-btn:hover {
    color: white;
    background-color: rgba(80, 80, 80, 0.8);
    scale: 1.05;
}
.speed-btn:active {
    scale: 0.95;
}
.speed-btn-selected {
    background-color: var(--color-accent);
    border-color: rgb(255, 224, 130);
    color: rgb(40, 30, 10);
    -unity-text-outline-width: 0;
}
.speed-btn-selected:hover {
    background-color: rgb(255, 224, 130);
    color: rgb(40, 30, 10);
}
.center-container {
    align-items: center;
    justify-content: flex-start;
}
.health-bar-container {
    width: 500px;
    height: 45px;
    background-color: rgba(0, 0, 0, 0.8);
    border-radius: 15px;
    border-width: 4px;
    border-color: rgb(192, 57, 43);
    margin-bottom: 10px;
    overflow: hidden;
    position: relative;
    justify-content: center;
    align-items: center;
}
.health-bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(46, 204, 113);
    transition-duration: 0.2s, 0.5s;
    transition-property: width, background-color;
}
.health-bar-text {
    position: absolute;
    font-size: 26px;
    color: white;
    -unity-font-style: bold;
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.8);
}
.currency-icon {
    width: 60px;
    height: 60px;
    background-color: var(--color-primary);
    border-radius: 20px;
    margin-right: 15px;
}
.currency-icon-small {
    width: 20px;
    height: 20px;
    margin-right: 5px;
    -unity-background-scale-mode: scale-to-fit;
}
.currency-text {
    font-size: 45px;
    color: white;
    -unity-font-style: bold;
}
.options-btn-small {
    width: 75px;
    height: 75px;
    position: absolute;
    right: 0;
    top: 0;
    background-color: transparent;
    background-image: url("project://database/Assets/_Custom/UI/Sprites/Icon%20Test.png?fileID=2800000&guid=21736d5db8c671242ab644e8beeca9a6&type=3#Icon Test");
    border-radius: 15px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.8);
    padding: 0;
    margin: 0;
    -unity-text-align: middle-center;
    transition-duration: 0.1s;
    transition-property: scale, background-color;
    border-top-width: 4px;
    border-left-width: 4px;
    border-right-width: 4px;
    background-size: 90% 90%;
}
.options-btn-small:hover {
    scale: 1.1;
    background-color: rgba(255, 255, 255, 0.2);
}
.options-btn-small:active {
    scale: 0.9;
    background-color: rgba(255, 255, 255, 0.4);
}
.bottom-bar {
    width: 100%;
    height: 150px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 20px;
    align-items: center;
    justify-content: space-between;
    flex-direction: row;
    padding: 0 40px;
}
.wave-container {
    background-color: rgba(0, 0, 0, 0.6);
    padding: 8px 30px;
    border-radius: 12px;
    border-width: 3px;
    border-color: rgb(211, 84, 0);
    align-items: center;
    justify-content: center;
}
.wave-text {
    font-size: 30px;
    color: white;
    -unity-font-style: bold;
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.5);
}
.wave-subtitle-text {
    font-size: 20px;
    color: rgb(240, 240, 240);
    -unity-font-style: italic;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.8);
    margin-top: 5px;
}
.start-wave-btn {
    position: absolute;
    bottom: 155px;
    right: 15px;
    padding: 10px 20px;
    font-size: 28px;
    color: rgb(240, 255, 240);
    -unity-font-style: bold;
    height: 140px;
    width: 360px;
    margin: 0;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-background-image-tint-color: rgb(100, 255, 120);
    background-color: transparent;
    border-width: 0;
}
.start-wave-btn:hover {
    scale: 1.05;
    -unity-background-image-tint-color: rgb(140, 255, 160);
}
.start-wave-btn:active {
    scale: 0.95;
    -unity-background-image-tint-color: rgb(80, 200, 100);
}
.next-board-btn {
    position: absolute;
    bottom: 155px;
    left: 15px;
    padding: 10px 20px;
    font-size: 28px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    height: 140px;
    width: 360px;
    margin: 0;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-background-image-tint-color: rgb(100, 160, 200);
    background-color: transparent;
    border-width: 0;
}
.next-board-btn:hover {
    scale: 1.05;
    -unity-background-image-tint-color: rgb(120, 180, 220);
}
.next-board-btn:active {
    scale: 0.95;
    -unity-background-image-tint-color: rgb(80, 140, 180);
}
.big-announcer-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    transition-duration: 0.5s;
    transition-property: opacity, scale;
    opacity: 0;
    scale: 0.8;
}
.big-announcer-text {
    font-size: 150px;
    color: rgb(241, 196, 15);
    -unity-font-style: bold;
    text-shadow: 5px 5px 0 rgba(0, 0, 0, 0.8);
    -unity-text-align: middle-center;
}
.fade-in {
    opacity: 1;
    scale: 1;
}
.abilities-container {
    flex-direction: row;
}
.ability-slot {
    width: 110px;
    height: 110px;
    background-color: rgba(0, 0, 0, 0.5);
    border-color: rgb(241, 196, 15);
    border-width: 4px;
    border-radius: 15px;
    margin-right: 15px;
    padding: 0;
    position: relative;
    overflow: hidden;
    transition-duration: 0.1s, 0.05s;
    transition-property: scale, translate;
    background-image: none;
}
.ability-slot:hover {
    scale: 1.05;
}
.ability-slot:active {
    scale: 0.95;
}
.ability-slot.locked {
    background-color: rgba(50, 50, 50, 0.8);
    border-color: rgba(150, 150, 150, 0.8);
}
.ability-slot.locked .ability-hotkey {
    opacity: 0.5;
}
.ability-slot.locked .lock-overlay {
    display: flex;
    border-radius: 12px;
}
.buy-tower-btn.locked .lock-overlay {
    display: flex;
    background-color: transparent;
}
.buy-tower-btn.locked {
    -unity-background-image-tint-color: rgb(80, 80, 80);
}
.lock-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.6);
    display: none;
}
.lock-icon {
    width: 28px;
    height: 28px;
    margin-bottom: 2px;
}
.lock-price {
    font-size: 26px;
    color: rgb(241, 196, 15);
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: black;
}
.buy-tower-btn {
    width: 250px;
    height: 165px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 10px;
    right: auto;
    bottom: auto;
    transition-property: translate;
    transition-duration: 0.05s;
}
.buy-tower-title {
    font-size: 25px;
    -unity-font-style: bold;
    color: rgb(80, 60, 40);
    white-space: normal;
    -unity-text-align: middle-center;
    -unity-text-outline-color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
}
.buy-tower-price {
    font-size: 25px;
    -unity-font-style: bold;
    color: rgb(241, 196, 15);
    margin-top: -10px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}
.ability-hotkey {
    position: absolute;
    top: 2px;
    left: 4px;
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    text-shadow: 2px 2px 0 rgb(0, 0, 0);
}
.ability-icon-vector {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
.cooldown-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
.uses-label {
    position: absolute;
    right: 4px;
    bottom: 2px;
    font-size: 18px;
    color: rgb(241, 196, 15);
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: black;
    display: none;
}
.wave-subtitle-text {
    transition-property: opacity, scale;
    transition-duration: 0.5s, 1s;
    transition-timing-function: ease-in-out;
    opacity: 1;
    scale: 1;
}
.wave-subtitle-text.breathe {
    scale: 1.1;
    opacity: 0.8;
}
.wave-subtitle-text.fade-out {
    opacity: 0;
}
