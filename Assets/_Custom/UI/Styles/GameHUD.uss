.hud-container {
    flex-grow: 1;
    justify-content: space-between;
    padding: 20px;
}

.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
}

.currency-container {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 10px 30px;
    border-radius: 15px;
    border-width: 4px;
    border-color: var(--color-accent);
}

.currency-icon {
    width: 60px;
    height: 60px;
    background-color: var(--color-primary);
    border-radius: 20px;
    margin-right: 15px;
}

.currency-text {
    font-size: 45px;
    color: white;
    -unity-font-style: bold;
}

.options-btn-small {
    width: 80px;
    height: 90px;
    background-color: var(--color-primary);
    border-radius: 15px;
    border-width: 0;
    transition-duration: 0.1s;
    transition-property: scale, background-color;
}

.options-btn-small:hover {
    scale: 1.1;
    background-color: var(--color-secondary);
}

.options-btn-small:active {
    scale: 0.9;
}

.bottom-bar {
    width: 100%;
    height: 150px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 20px;
    align-items: center;
    justify-content: center;
}

/* --- ESTILOS DE OLEADA --- */
.wave-container {
    background-color: rgba(0, 0, 0, 0.6);
    padding: 10px 40px;
    border-radius: 15px;
    border-width: 4px;
    border-color: #D35400;
    align-items: center;
    justify-content: center;
}

.wave-text {
    font-size: 40px;
    color: white;
    -unity-font-style: bold;
    text-shadow: 2px 2px 0 rgba(0,0,0,0.5);
}

.start-wave-btn {
    position: absolute;
    bottom: 170px;
    right: 20px;
    background-color: #27ae60;
    background-image: none;
    border-color: #2ecc71;
    border-width: 4px;
    padding: 15px 30px;
    font-size: 28px;
    border-radius: 15px;
    color: white;
    -unity-font-style: bold;
}
