.unity-button {
    font-size: 55px;
    color: rgb(80, 60, 40);
    background-color: transparent;
    border-width: 0;
    width: 380px;
    height: 140px;
    margin: 15px;
    transition-duration: 0.1s;
    transition-property: scale, -unity-background-image-tint-color;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-image: url("project://database/Assets/_Custom/UI/Sprites/Boton.png?fileID=2800000&guid=b6a8459c55edcee49a0391d6800af88f&type=3#Boton");
}

.unity-button:hover {
    scale: 1.05;
    -unity-background-image-tint-color: rgb(220, 220, 220);
}

.unity-button:active {
    scale: 0.95;
    -unity-background-image-tint-color: rgb(180, 180, 180);
}

.panel-container {
    background-color: rgba(0, 0, 0, 0);
    padding: 20px;
    align-items: center;
    justify-content: center;
    border-width: 0;
}

.game-logo {
    width: 800px;
    height: 450px;
    margin-top: 40px;
    margin-bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.options-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.667);
    align-items: center;
    justify-content: center;
    display: flex;
}

.options-panel {
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    padding: 100px 100px 80px 100px;
    border-width: 0;
    min-width: 600px;
    align-items: stretch;
}

.title-text {
    font-size: 80px;
    color: rgb(80, 60, 40);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 40px;
    padding-bottom: 15px;
    border-bottom-width: 4px;
    border-bottom-color: rgba(80, 60, 40, 0.4);
    text-shadow: 2px 2px 0 rgba(255, 255, 255, 0.6);
    -unity-text-outline-width: 0;
}

.slider-container {
    margin-bottom: 40px;
}

.slider-label {
    font-size: 40px;
    color: rgb(80, 60, 40);
    -unity-font-style: bold;
    margin-bottom: 15px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    text-shadow: 1px 1px 0 rgba(255, 255, 255, 0.6);
}

.unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0.5);
    border-color: rgb(127, 140, 141);
    border-width: 2px;
    border-radius: 10px;
    height: 20px;
    margin-top: -10px;
}

.unity-base-slider__dragger {
    background-color: var(--color-accent);
    border-color: rgb(211, 84, 0);
    border-width: 4px;
    border-radius: 20px;
    width: 40px;
    height: 40px;
    margin-top: -20px;
    transition-duration: 0.1s;
}

.unity-base-slider__dragger:hover {
    scale: 1.2;
    background-color: var(--color-secondary);
}

.banner-image {
    width: 800px;
    height: 400px;
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 20px;
    align-self: center;
}

.mini-action-box {
    background-color: rgba(0, 0, 0, 0);
    padding: 0;
    width: 700px;
    height: 220px;
    align-items: center;
    justify-content: center;
    flex-direction: row;
    align-self: center;
}

.mini-action-box .unity-button {
    margin: 0 10px;
    width: 260px;
    height: 110px;
    font-size: 32px;
    padding-bottom: 10px;
}

.credit-text {
    font-size: 35px;
    color: rgb(80, 60, 40);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 15px;
    text-shadow: 2px 2px 0 rgba(255, 255, 255, 0.8);
}

.panel-btn-next {
    background-image: url('../Sprites/Panel/nuevoboton1.png');
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(240, 240, 240);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.8);
}

.panel-btn-menu {
    background-image: url('../Sprites/Panel/nuevoboton2.png');
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(240, 240, 240);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.8);
}
