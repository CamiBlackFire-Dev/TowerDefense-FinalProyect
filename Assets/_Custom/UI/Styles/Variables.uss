:root {
    --color-primary: rgba(0, 0, 0, 0);
    --color-secondary: rgba(255, 255, 255, 0.2);
    --color-accent: rgb(241, 196, 15);
    --color-text: rgb(236, 240, 241);
    --color-text-dark: rgb(44, 62, 80);
    --color-background: rgba(15, 10, 5, 0.95);
    --font-size-title: 120px;
    --font-size-subtitle: 32px;
    --font-size-button: 45px;
    --font-size-body: 18px;
    --border-radius-btn: 12px;
    --border-radius-panel: 20px;
    -unity-font-definition: url("project://database/Assets/_Custom/UI/Fonts/Bangers-Regular.ttf?fileID=12800000&guid=5cc4a18f6681fb04e8882d2de18e9e44&type=3#Bangers-Regular");
}




